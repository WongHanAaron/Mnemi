@page "/signup"
@layout Ui.Shared.Components.Layout.AuthLayout
@using Ui.Shared.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

@* Matches BlazorBlueprintUI signup-03 design *@

<div class="auth-card">
    <div class="auth-card__header">
        <div class="auth-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"/>
            </svg>
        </div>
        <h1 class="auth-card__title">Create an account</h1>
        <p class="auth-card__description">Sign up with your Google or GitHub account</p>
    </div>

    <div class="auth-card__content">
        @* Show only accepted OAuth providers from the codebase: Google + GitHub *@
        <div class="auth-providers">
            <button type="button"
                    class="auth-provider-btn"
                    data-testid="auth-signup-google"
                    disabled="@_isLoading"
                    @onclick="() => HandleOAuthSignupAsync(AuthProvider.Google)">
                <span class="auth-provider-btn__icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                </span>
                <span class="auth-provider-btn__label">
                    @(_isLoading ? "Signing up..." : "Sign up with Google")
                </span>
            </button>

            <button type="button"
                    class="auth-provider-btn"
                    data-testid="auth-signup-github"
                    disabled="@_isLoading"
                    @onclick="() => HandleOAuthSignupAsync(AuthProvider.GitHub)">
                <span class="auth-provider-btn__icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                </span>
                <span class="auth-provider-btn__label">
                    @(_isLoading ? "Signing up..." : "Sign up with GitHub")
                </span>
            </button>
        </div>

        @* "OR CONTINUE WITH" divider *@
        <div class="auth-divider">
            <span class="auth-divider__text">Or continue with</span>
        </div>

        @* Registration form for future username/password auth *@
        <form class="auth-form" @onsubmit="HandleEmailSignupAsync">
            <div class="auth-form__field">
                <label class="auth-form__label" for="signup-name">Full Name</label>
                <input class="auth-form__input"
                       id="signup-name"
                       type="text"
                       placeholder="John Doe"
                       @bind="_fullName"
                       @bind:event="oninput"
                       autocomplete="name" />
            </div>

            <div class="auth-form__field">
                <label class="auth-form__label" for="signup-email">Email</label>
                <input class="auth-form__input"
                       id="signup-email"
                       type="email"
                       placeholder="m@example.com"
                       @bind="_email"
                       @bind:event="oninput"
                       autocomplete="email" />
            </div>

            <div class="auth-form__field">
                <label class="auth-form__label" for="signup-password">Password</label>
                <input class="auth-form__input"
                       id="signup-password"
                       type="password"
                       @bind="_password"
                       @bind:event="oninput"
                       autocomplete="new-password" />
            </div>

            <button type="submit"
                    class="auth-submit-btn"
                    disabled="@_isLoading">
                @(_isLoading ? "Creating account..." : "Create Account")
            </button>
        </form>
    </div>

    <div class="auth-card__footer">
        <div class="auth-card__footer-text">
            Already have an account?
            <a href="/login" class="auth-card__footer-link">Sign in</a>
        </div>
    </div>
</div>

<p class="auth-terms">
    By clicking continue, you agree to our
    <a href="#" class="auth-terms__link">Terms of Service</a>
    and
    <a href="#" class="auth-terms__link">Privacy Policy</a>.
</p>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="auth-card" style="margin-top: 1rem;">
        <div class="auth-error" role="alert">
            @_errorMessage
        </div>
    </div>
}

@code {
    private bool _isLoading;
    private string? _errorMessage;
    private string _fullName = "";
    private string _email = "";
    private string _password = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthService.GetCurrentAuthStateAsync();
        if (state.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleOAuthSignupAsync(AuthProvider provider)
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            await AuthService.LoginAsync(provider);
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleEmailSignupAsync()
    {
        // Email/password registration is a future feature.
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        _errorMessage = "Email/password registration is coming soon. Please use Google or GitHub to sign up.";
        _isLoading = false;
        StateHasChanged();
        await Task.CompletedTask;
    }
}
