@namespace Ui.Shared.Components.Layout
@inject NavigationManager Navigation

<Ui.Shared.Components.Layout.SidebarNavButton
    Class="@(IsActive ? "bg-[var(--sidebar-accent)]" : "")"
    TestId="@($"sidebar-nav-link-{Id}")"
    OnClick="() => Navigation.NavigateTo(Href)">
    <LucideIcon Name="@GetLucideName()" Size="18" Class="mr-3 flex-shrink-0" />
    <span>@Label</span>
</Ui.Shared.Components.Layout.SidebarNavButton>

@code {
    /// <summary>Unique identifier for testing.</summary>
    [Parameter]
    public string Id { get; set; } = "";

    /// <summary>The display label.</summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>The navigation target URL.</summary>
    [Parameter]
    public string Href { get; set; } = "/";

    /// <summary>The icon kind: "home", "review", "decks", or empty for default.</summary>
    [Parameter]
    public string IconKind { get; set; } = "";

    /// <summary>Whether this link corresponds to the current page.</summary>
    [Parameter]
    public bool IsActive { get; set; }

    private string GetLucideName() => IconKind switch
    {
        "home" => "house",
        "review" => "book-open",
        "decks" => "grid-3x3",
        _ => "circle"
    };
}
