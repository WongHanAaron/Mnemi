@namespace Ui.Shared.Components.Layout

<svg class="sidebar-nav-link__icon @Class" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
     width="1.125rem" height="1.125rem"
     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    @ChildContent
</svg>

@code {
    /// <summary>CSS class to apply to the icon container.</summary>
    [Parameter]
    public string Class { get; set; } = string.Empty;

    /// <summary>The icon content (SVG paths) to render.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
