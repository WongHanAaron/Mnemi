@using Ui.Shared.Models.Home

<div data-testid="@($"quick-stat-{Metric.MetricId}")">
    <BbCard Class="text-center">
        <BbCardContent>
            <div class="text-2xl font-bold">@DisplayValue</div>
            <div class="text-sm text-[var(--muted-foreground)]">@Metric.Label</div>
            @if (!string.IsNullOrWhiteSpace(Metric.TrendText) && Metric.State == SectionDataState.Populated)
            {
                <span>
                    <BbBadge Variant="@(Metric.TrendDirection == MetricTrendDirection.Up ? BadgeVariant.Default : BadgeVariant.Destructive)">
                        @Metric.TrendText
                    </BbBadge>
                </span>
            }
        </BbCardContent>
    </BbCard>
</div>

@code {
    [Parameter]
    public QuickStatMetricViewModel Metric { get; set; } = new(
        MetricId: "metric",
        Label: "Metric",
        ValueText: "0",
        TrendText: null,
        TrendDirection: MetricTrendDirection.Unknown,
        State: SectionDataState.MissingData);

    private string DisplayValue => Metric.State == SectionDataState.MissingData ? "Unavailable" : Metric.ValueText;
}
