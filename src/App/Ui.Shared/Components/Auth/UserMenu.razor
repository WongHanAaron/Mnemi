@using Ui.Shared.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<BbDropdownMenu>
    <BbDropdownMenuTrigger AsChild>
        <BbButton Variant="ButtonVariant.Ghost"
                  data-testid="auth-user-menu-trigger"
                  Class="gap-3 px-2">
            @if (!string.IsNullOrEmpty(_authState?.AvatarUrl))
            {
                <img class="w-8 h-8 rounded-full object-cover flex-shrink-0"
                     src="@_authState.AvatarUrl"
                     alt="User avatar"
                     width="32"
                     height="32" />
            }
            else
            {
                <BbAvatar Size="AvatarSize.Small">
                    <BbAvatarFallback>@GetInitials()</BbAvatarFallback>
                </BbAvatar>
            }
            <span class="font-medium whitespace-nowrap overflow-hidden text-ellipsis max-w-[120px]">@_authState?.DisplayName</span>
        </BbButton>
    </BbDropdownMenuTrigger>
    <BbDropdownMenuContent data-testid="auth-user-menu-dropdown">
        <div class="px-3 py-2 border-b border-[var(--border)]">
            <span class="text-xs text-[var(--muted-foreground)] break-all">@_authState?.Email</span>
        </div>
        <BbDropdownMenuItem data-testid="auth-user-menu-settings"
                            OnClick="NavigateToSettings">
            Account Settings
        </BbDropdownMenuItem>
        <BbDropdownMenuSeparator />
        <BbDropdownMenuItem data-testid="auth-user-menu-signout"
                            OnClick="HandleSignOutAsync"
                            Disabled="@_isSigningOut">
            @(_isSigningOut ? "Signing out..." : "Sign Out")
        </BbDropdownMenuItem>
    </BbDropdownMenuContent>
</BbDropdownMenu>

@code {
    private AuthState? _authState;
    private bool _isSigningOut;

    protected override async Task OnInitializedAsync()
    {
        _authState = await AuthService.GetCurrentAuthStateAsync();
        AuthService.AuthStateChanged += HandleAuthStateChanged;
    }

    public void Dispose()
    {
        AuthService.AuthStateChanged -= HandleAuthStateChanged;
    }

    private async Task HandleSignOutAsync()
    {
        _isSigningOut = true;
        StateHasChanged();

        var result = await AuthService.LogoutAsync();

        _isSigningOut = false;

        if (result.Success)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void HandleAuthStateChanged(AuthState state)
    {
        _authState = state;
        StateHasChanged();
    }

    private void NavigateToSettings()
    {
        Navigation.NavigateTo("/account");
    }

    private string GetInitials()
    {
        if (string.IsNullOrEmpty(_authState?.DisplayName))
            return "?";

        var parts = _authState.DisplayName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return $"{parts[0][..1]}{parts[^1][..1]}".ToUpper();
    }
}
