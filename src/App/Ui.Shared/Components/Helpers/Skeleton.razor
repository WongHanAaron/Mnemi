<div class="skeleton @GetVariantClass() @(ClassName ?? "")" style="@InlineStyle" role="status" aria-label="Loading">
    <span class="sr-only">Loading...</span>
</div>

@code {
    /// <summary>
    /// Variant: "text", "text-short", "avatar", "badge", "btn", or "row" (default).
    /// </summary>
    [Parameter]
    public string? Variant { get; set; }

    /// <summary>
    /// Optional additional CSS class.
    /// </summary>
    [Parameter]
    public string? ClassName { get; set; }

    /// <summary>
    /// Optional inline width override (e.g., "50%", "3rem").
    /// </summary>
    [Parameter]
    public string? Width { get; set; }

    private string? InlineStyle => Width is not null ? $"width:{Width}" : null;

    private string GetVariantClass() => Variant switch
    {
        "text" => "skeleton--text",
        "text-short" => "skeleton--text-short",
        "avatar" => "skeleton--avatar",
        "badge" => "skeleton--badge",
        "btn" => "skeleton--btn",
        _ => "skeleton--row"
    };
}
