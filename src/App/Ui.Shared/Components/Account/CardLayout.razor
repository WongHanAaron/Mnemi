<div class="account-card @(Danger ? "account-card--danger" : "") @(ClassName ?? "")" data-testid="@DataTestId">
    <header class="account-card__header">
        <h2 class="account-card__title @(Danger ? "account-card__title--danger" : "")">@Title</h2>
        @if (HeaderActions is not null)
        {
            @HeaderActions
        }
    </header>
    <div class="account-card__body">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? DataTestId { get; set; }
    [Parameter] public bool Danger { get; set; }
    [Parameter] public string? ClassName { get; set; }
}
