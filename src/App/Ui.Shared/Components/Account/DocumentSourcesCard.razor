@inherits Ui.Shared.Components.Helpers.AsyncDataComponent
@inject IDocumentSourceService SourceService

<div data-testid="document-sources-card">
    <BbCard>
    <BbCardHeader Class="flex-row items-center justify-between">
        <BbCardTitle>Document Sources</BbCardTitle>
        <BbButton Variant="ButtonVariant.Default"
                  Size="ButtonSize.Small"
                  data-testid="add-source-button"
                  OnClick="HandleAddSource">
            + Add
        </BbButton>
    </BbCardHeader>
    <BbCardContent>
        @if (IsLoading)
        {
            <div class="sources-skeleton" data-testid="sources-loading">
                @for (var i = 0; i < 2; i++)
                {
                    <div class="flex items-center gap-3 py-3 border-b border-[var(--border)]">
                        <div class="flex-1 flex flex-col gap-1.5">
                            <BbSkeleton Shape="SkeletonShape.Rectangular" Class="w-3/5 h-3.5" />
                        </div>
                        <BbSkeleton Shape="SkeletonShape.Rectangular" Class="w-16 h-5" />
                        <BbSkeleton Shape="SkeletonShape.Rectangular" Class="w-12 h-5" />
                        <BbSkeleton Shape="SkeletonShape.Rectangular" Class="w-14 h-6" />
                        <BbSkeleton Shape="SkeletonShape.Rectangular" Class="w-14 h-6" />
                    </div>
                }
            </div>
        }
        else if (_sources.Count == 0)
        {
            <p class="sources-empty" data-testid="sources-empty">
                No document sources linked.
                <span class="sources-empty__link" @onclick="HandleAddSource" role="button" tabindex="0">
                    Add your first source to start studying
                </span>
            </p>
        }
        else
        {
            <div class="sources-list" data-testid="sources-list">
                @foreach (var source in _sources)
                {
                    <SourceRow Source="source"
                               OnRename="HandleRenameAsync"
                               OnRemove="HandleRemoveAsync" />
                }
            </div>
        }

        @if (ErrorMessage is not null)
        {
            <p class="sources-error" data-testid="sources-error">@ErrorMessage</p>
        }
    </BbCardContent>
    </BbCard>
</div>

@code {
    private IReadOnlyList<SourceInfo> _sources = Array.Empty<SourceInfo>();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(
            async () => _sources = await SourceService.ListSourcesAsync(),
            "Failed to load document sources. Please try again.");
    }

    private async Task HandleRenameAsync((string SourceId, string DisplayName) args)
    {
        ErrorMessage = null;
        var (sourceId, displayName) = args;

        var result = await SourceService.UpdateSourceDisplayNameAsync(sourceId, displayName);

        if (result.Success)
        {
            await LoadAsync(
                async () => _sources = await SourceService.ListSourcesAsync(),
                "Failed to load document sources. Please try again.");
        }
        else
        {
            ErrorMessage = result.ErrorMessage;
        }
    }

    private async Task HandleRemoveAsync(string sourceId)
    {
        ErrorMessage = null;

        var result = await SourceService.RemoveSourceAsync(sourceId);

        if (result.Success)
        {
            await LoadAsync(
                async () => _sources = await SourceService.ListSourcesAsync(),
                "Failed to load document sources. Please try again.");
        }
        else
        {
            ErrorMessage = result.ErrorMessage;
        }
    }

    private void HandleAddSource()
    {
        // TODO: Navigate to /account/sources/new (future phase)
    }
}
