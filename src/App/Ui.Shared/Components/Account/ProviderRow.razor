@inject IProviderIconService IconService

<div class="provider-row" data-testid="provider-row">
    <div class="provider-row__info">
        <span class="provider-row__icon" aria-hidden="true">
            @IconService.GetProviderIcon(Provider.ProviderName)
        </span>
        <div class="provider-row__details">
            <span class="provider-row__name">@Provider.ProviderName</span>
            <span class="provider-row__connected-as">@Provider.ConnectedAs</span>
        </div>
    </div>
    <span data-testid="provider-status">
        <BbBadge Variant="@(Provider.IsValid ? BadgeVariant.Default : BadgeVariant.Secondary)">
            @(Provider.IsValid ? "✅ Active" : "⚠️ Expired")
        </BbBadge>
    </span>
    <BbButton Variant="ButtonVariant.Ghost"
              Size="ButtonSize.Small"
              data-testid="provider-unlink-button"
              Disabled="@(!CanUnlink)"
              title="@(CanUnlink ? $"Unlink {Provider.ProviderName}" : "Must have at least one linked provider")"
              OnClick="() => OnUnlink.InvokeAsync(Provider.ConnectionId)">
        Unlink
    </BbButton>
</div>

@code {
    [Parameter, EditorRequired]
    public ProviderInfo Provider { get; set; } = null!;

    [Parameter]
    public bool CanUnlink { get; set; } = true;

    [Parameter]
    public EventCallback<string> OnUnlink { get; set; }
}
