@inherits Ui.Shared.Components.Helpers.AsyncDataComponent
@inject IUserService UserService

<div data-testid="linked-providers-card">
    <BbCard>
    <BbCardHeader Class="flex-row items-center justify-between">
        <BbCardTitle>Linked Providers</BbCardTitle>
        <BbButton Variant="ButtonVariant.Default"
                  Size="ButtonSize.Small"
                  data-testid="link-new-provider-button"
                  OnClick="HandleLinkNew">
            + Link New
        </BbButton>
    </BbCardHeader>
    <BbCardContent>
        @if (IsLoading)
        {
            <div class="providers-skeleton" data-testid="providers-loading">
                @for (var i = 0; i < 2; i++)
                {
                    <div class="flex items-center gap-3 py-3 border-b border-[var(--border)]">
                        <BbSkeleton Shape="SkeletonShape.Circular" Class="w-7 h-7" />
                        <div class="flex-1 flex flex-col gap-1.5">
                            <BbSkeleton Shape="SkeletonShape.Rectangular" Class="w-3/5 h-3.5" />
                            <BbSkeleton Shape="SkeletonShape.Rectangular" Class="w-2/5 h-3" />
                        </div>
                        <BbSkeleton Shape="SkeletonShape.Rectangular" Class="w-16 h-5" />
                        <BbSkeleton Shape="SkeletonShape.Rectangular" Class="w-14 h-6" />
                    </div>
                }
            </div>
        }
        else if (_providers.Count == 0)
        {
            <p class="providers-empty" data-testid="providers-empty">
                No providers linked.
                <span class="providers-empty__link" @onclick="HandleLinkNew" role="button" tabindex="0">
                    Link your first provider
                </span>
            </p>
        }
        else
        {
            <div class="providers-list" data-testid="providers-list">
                @foreach (var provider in _providers)
                {
                    <ProviderRow Provider="provider"
                                 CanUnlink="@(_providers.Count > 1)"
                                 OnUnlink="HandleUnlinkAsync" />
                }
            </div>
        }

        @if (ErrorMessage is not null)
        {
            <p class="providers-error" data-testid="providers-error">@ErrorMessage</p>
        }
    </BbCardContent>
    </BbCard>
</div>

@code {
    private IReadOnlyList<ProviderInfo> _providers = Array.Empty<ProviderInfo>();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(
            async () => _providers = await UserService.ListProvidersAsync(),
            "Failed to load providers. Please try again.");
    }

    private async Task HandleUnlinkAsync(string connectionId)
    {
        ErrorMessage = null;

        var provider = _providers.FirstOrDefault(p => p.ConnectionId == connectionId);
        if (provider is null) return;

        var result = await UserService.UnlinkProviderAsync(connectionId);

        if (result.Success)
        {
            await LoadAsync(
                async () => _providers = await UserService.ListProvidersAsync(),
                "Failed to load providers. Please try again.");
        }
        else
        {
            ErrorMessage = result.ErrorMessage;
        }
    }

    private void HandleLinkNew()
    {
        // TODO: Redirect to OAuth flow with returnUrl=/account
    }
}
