@inject IUserService UserService
@inject ToastService ToastService
@using Mnemi.Application.Ports

<div data-testid="account-profile-card">
    <BbCard>
    <BbCardHeader Class="flex-row items-center justify-between">
        <BbCardTitle>Profile</BbCardTitle>
        @if (!_isEditing)
        {
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Small"
                      data-testid="profile-edit-button"
                      OnClick="EnterEditMode">
                Edit
            </BbButton>
        }
        else
        {
            <div class="flex gap-2">
                <BbButton Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Small"
                          data-testid="profile-cancel-button"
                          OnClick="CancelEdit">
                    Cancel
                </BbButton>
                <BbButton Variant="ButtonVariant.Default"
                          Size="ButtonSize.Small"
                          data-testid="profile-save-button"
                          Disabled="@_isSaving"
                          OnClick="SaveEditAsync">
                    @(_isSaving ? "Saving..." : "Save")
                </BbButton>
            </div>
        }
    </BbCardHeader>
    <BbCardContent>
        <div class="account-field">
            <label class="account-field__label" for="profile-display-name">Display Name</label>
            @if (!_isEditing)
            {
                <span class="account-field__value"
                      data-testid="profile-display-name-text">
                    @DisplayName
                </span>
            }
            else
            {
                <BbInput Type="InputType.Text"
                         @bind-Value="_editValue"
                         data-testid="profile-display-name-input"
                         @onkeydown="HandleKeyDown"
                         MaxLength="101"
                         autofocus
                         Class="@(_errorMessage is not null ? "border-[var(--destructive)]" : "")" />
                @if (_errorMessage is not null)
                {
                    <span class="account-field__error"
                          data-testid="profile-display-name-error">
                        @_errorMessage
                    </span>
                }
            }
        </div>

        <div class="account-field">
            <label class="account-field__label">Email</label>
            <span class="account-field__value account-field__value--muted"
                  data-testid="profile-email-text">
                @Email
            </span>
        </div>

        <div class="account-field">
            <label class="account-field__label">Member Since</label>
            <span class="account-field__value account-field__value--muted"
                  data-testid="profile-member-since-text">
                @MemberSinceFormatted
            </span>
        </div>
    </BbCardContent>
    </BbCard>
</div>

@code {
    private bool _isEditing;
    private bool _isSaving;
    private string _editValue = string.Empty;
    private string? _errorMessage;

    [Parameter]
    public string DisplayName { get; set; } = "Student";

    [Parameter]
    public string Email { get; set; } = "student@mnemi.app";

    [Parameter]
    public DateTime MemberSince { get; set; } = new(2026, 1, 15, 0, 0, 0, DateTimeKind.Utc);

    [Parameter]
    public EventCallback<string> OnDisplayNameChanged { get; set; }

    private string MemberSinceFormatted => MemberSince.ToString("MMMM d, yyyy");

    protected override void OnParametersSet()
    {
        if (!_isEditing)
        {
            _editValue = DisplayName;
        }
    }

    private void EnterEditMode()
    {
        _editValue = DisplayName;
        _errorMessage = null;
        _isEditing = true;
    }

    private void CancelEdit()
    {
        _editValue = DisplayName;
        _errorMessage = null;
        _isEditing = false;
    }

    private async Task SaveEditAsync()
    {
        _errorMessage = null;

        // Client-side validation — avoid unnecessary service calls
        if (string.IsNullOrWhiteSpace(_editValue))
        {
            _errorMessage = "Display name is required.";
            return;
        }

        if (_editValue.Length > ValidationConstants.MaxDisplayNameLength)
        {
            _errorMessage = $"Display name must be {ValidationConstants.MaxDisplayNameLength} characters or less.";
            return;
        }

        _isSaving = true;

        var result = await UserService.UpdateDisplayNameAsync(_editValue.Trim());

        _isSaving = false;

        if (result.Success)
        {
            DisplayName = _editValue.Trim();
            _isEditing = false;
            await OnDisplayNameChanged.InvokeAsync(DisplayName);
            ToastService.Show("✓ Saved");
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter")
        {
            await SaveEditAsync();
        }
        else if (e.Key is "Escape")
        {
            CancelEdit();
        }
    }
}
